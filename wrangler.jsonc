{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boleia-web",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public/",
    "binding": "ASSETS"
  },
  // @nuxt/content storage; without database_id wrangler creates the database on the first deploy
  "d1_databases": [
    { "binding": "DB", "database_name": "boleia-content" }
  ],
  "observability": { "enabled": true },
  // variables added in the dashboard survive a deploy; the ones below still win by name
  "keep_vars": true,
  // Public runtime values. The Supabase URL and anon key are baked in at build time from .env;
  // NUXT_APP_SECRET is a Worker secret (wrangler secret put), never here.
  "vars": {
    "NUXT_PUBLIC_SITE_URL": "https://boleia.ao",
    "NUXT_PUBLIC_SUPPORT_EMAIL": "apoio@boleia.ao",
    // "false" until launch: the backend is still the shared test project
    "NUXT_PUBLIC_SITE_INDEXABLE": "false"
  }
}
