{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boleia-web",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-06-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./.output/public/",
    "binding": "ASSETS"
  },
  // @nuxt/content storage; without database_id wrangler creates the database on the first deploy
  "d1_databases": [
    { "binding": "DB", "database_name": "boleia-content" }
  ],
  "observability": { "enabled": true }
  // SUPABASE_URL and SUPABASE_KEY: wrangler secret put / dashboard vars, never here.
}
