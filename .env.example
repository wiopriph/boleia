# Shared dev project; values come from boleia-db/.env. Only the anon key, never service role.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_KEY=<anon key>
# public origin for canonical links and OG images, e.g. https://boleia.ao
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# signs OG image URLs in production (nuxt-og-image); 32+ random characters, set as a Worker secret
NUXT_APP_SECRET=
